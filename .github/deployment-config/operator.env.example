# Copy to operator.env. This local file is ignored by Git.
# Values marked AUTO are populated from terraform/bootstrap outputs.

# Required operator input. These identify the repository that receives the
# GitHub environment variables and secrets.
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPOSITORY=YOUR_REPOSITORY_NAME

# Required operator input. Health-check alerts are sent here after SNS
# subscription confirmation.
ALARM_EMAIL=operator@example.com

# Development configuration.
DEV_ENABLE_DUCKDNS=false
DEV_ENABLE_LETSENCRYPT=false

# Production configuration.
PROD_ENABLE_DUCKDNS=true
PROD_ENABLE_LETSENCRYPT=true
PROD_DUCKDNS_SUBDOMAIN=fred-ai-assistant
PROD_LETSENCRYPT_EMAIL=fredrickritchie@gmail.com

# Never place DUCKDNS_TOKEN, passwords, or API keys in this file. The sync
# script prompts for the DuckDNS token and sends it directly to GitHub as an
# environment secret.
