# Copy to prod.env, replace every placeholder, then commit the non-secret file.
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/local-ai-assistant-github-deploy
ECR_REPOSITORY_URL=123456789012.dkr.ecr.ap-south-1.amazonaws.com/local-ai-assistant
TF_STATE_BUCKET=your-unique-terraform-state-bucket
TF_STATE_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/your-key-id
ALARM_EMAIL=operator@example.com
ENABLE_DUCKDNS=true
ENABLE_LETSENCRYPT=true
DUCKDNS_SUBDOMAIN=fred-ai-assistant
LETSENCRYPT_EMAIL=user@example.com
