[Unit]
Description=Local AI Assistant
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
WorkingDirectory={{ app_install_dir }}
User={{ app_user }}
Group={{ app_group }}
Environment=DEFAULT_MODEL={{ ollama_primary_model }}
Environment=DEFAULT_TEMPERATURE={{ app_default_temperature }}
Environment=REQUEST_TIMEOUT_SECONDS={{ app_request_timeout_seconds }}
Environment=MAX_HISTORY_MESSAGES={{ app_max_history_messages }}
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
ExecStart={{ app_install_dir }}/.venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
