[Unit]
Description=Local AI Assistant
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory={{ app_install_dir }}
ExecStartPre=-/usr/bin/docker rm -f local-ai-assistant
ExecStart=/usr/bin/docker run --name local-ai-assistant --network host -e DEFAULT_MODEL={{ ollama_primary_model }} -e DEFAULT_TEMPERATURE={{ app_default_temperature }} -e REQUEST_TIMEOUT_SECONDS={{ app_request_timeout_seconds }} -e MAX_HISTORY_MESSAGES={{ app_max_history_messages }} -e OLLAMA_BASE_URL={{ ollama_private_url }} {{ app_image_name }}
ExecStop=/usr/bin/docker stop -t 10 local-ai-assistant
ExecStopPost=-/usr/bin/docker rm -f local-ai-assistant
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
