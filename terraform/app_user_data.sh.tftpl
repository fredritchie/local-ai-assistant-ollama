#!/usr/bin/env bash

set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

STATUS_DIR="/var/lib/local-ai-assistant"
COMPLETE_MARKER="$STATUS_DIR/bootstrap-complete"
FAILED_MARKER="$STATUS_DIR/bootstrap-failed"
FAILURE_LINE="unknown"
FAILURE_COMMAND="unknown"

install -d -m 0755 "$STATUS_DIR"
rm -f "$COMPLETE_MARKER" "$FAILED_MARKER"

report_exit() {
    local exit_code=$?
    [[ "$exit_code" -eq 0 ]] && return
    {
        echo "service=streamlit"
        echo "status=failed"
        echo "exit_code=$exit_code"
        echo "line=$FAILURE_LINE"
        printf 'command=%q\n' "$FAILURE_COMMAND"
        echo "timestamp=$(date --iso-8601=seconds)"
    } | tee "$FAILED_MARKER" >&2
    echo "STREAMLIT_BOOTSTRAP_FAILED exit_code=$exit_code" >&2
}

trap 'FAILURE_LINE=$LINENO; FAILURE_COMMAND=$BASH_COMMAND' ERR
trap report_exit EXIT

apt-get update
apt-get install -y git curl ca-certificates python3 python3-pip python3-venv

install -d -o ubuntu -g ubuntu /opt/local-ai-assistant-ollama
if [[ ! -d /opt/local-ai-assistant-ollama/.git ]]; then
    sudo -u ubuntu git clone \
        --branch "${repository_branch}" \
        --single-branch \
        "${repository_url}" \
        /opt/local-ai-assistant-ollama
fi

if [[ -n "${repository_commit}" ]]; then
    sudo -u ubuntu git -C /opt/local-ai-assistant-ollama fetch origin "${repository_commit}"
    sudo -u ubuntu git -C /opt/local-ai-assistant-ollama checkout --detach "${repository_commit}"
fi

for _ in {1..360}; do
    if curl \
        --fail \
        --silent \
        --max-time 10 \
        --header 'Content-Type: application/json' \
        --data "{\"model\":\"${ollama_model}\"}" \
        "${ollama_private_url}/api/show" >/dev/null; then
        break
    fi
    sleep 10
done

if ! curl \
    --fail \
    --silent \
    --show-error \
    --max-time 10 \
    --header 'Content-Type: application/json' \
    --data "{\"model\":\"${ollama_model}\"}" \
    "${ollama_private_url}/api/show" >/dev/null; then
    echo "The private Ollama service did not load the primary model." >&2
    exit 1
fi

if [[ "${deployment_mode}" == "docker" ]]; then
    apt-get install -y docker.io
    systemctl enable --now docker
    docker build --pull -t local-ai-assistant:latest /opt/local-ai-assistant-ollama

    cat >/etc/systemd/system/local-ai-assistant.service <<'SERVICE'
[Unit]
Description=Streamlit web service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/local-ai-assistant-ollama
ExecStartPre=-/usr/bin/docker rm -f local-ai-assistant
ExecStart=/usr/bin/docker run --name local-ai-assistant --network host -e DEFAULT_MODEL=${ollama_model} -e OLLAMA_BASE_URL=${ollama_private_url} local-ai-assistant:latest
ExecStop=/usr/bin/docker stop -t 10 local-ai-assistant
ExecStopPost=-/usr/bin/docker rm -f local-ai-assistant
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
SERVICE
else
    sudo -u ubuntu python3 -m venv /opt/local-ai-assistant-ollama/.venv
    sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install --upgrade pip
    sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install -r /opt/local-ai-assistant-ollama/requirements.txt

    cat >/etc/systemd/system/local-ai-assistant.service <<'SERVICE'
[Unit]
Description=Streamlit web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/local-ai-assistant-ollama
Environment=DEFAULT_MODEL=${ollama_model}
Environment=OLLAMA_BASE_URL=${ollama_private_url}
ExecStart=/opt/local-ai-assistant-ollama/.venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE
fi

systemctl daemon-reload
systemctl enable --now local-ai-assistant.service

cat >/usr/local/bin/local-ai-assistant-health <<'HEALTH'
#!/usr/bin/env bash
set -euo pipefail
curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8501/_stcore/health
printf '\n'
HEALTH
chmod 0755 /usr/local/bin/local-ai-assistant-health

for _ in {1..60}; do
    /usr/local/bin/local-ai-assistant-health >/dev/null 2>&1 && break
    sleep 5
done
/usr/local/bin/local-ai-assistant-health

{
    echo "service=streamlit"
    echo "status=complete"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo "ollama_url=${ollama_private_url}"
} >"$COMPLETE_MARKER"
chmod 0644 "$COMPLETE_MARKER"
echo "STREAMLIT_BOOTSTRAP_COMPLETE"
