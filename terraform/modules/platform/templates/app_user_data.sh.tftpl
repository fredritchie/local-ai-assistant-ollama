#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee -a /var/log/local-ai-bootstrap.log) 2>&1
trap 'touch /var/lib/local-ai/bootstrap-failed' ERR

mkdir -p /var/lib/local-ai /etc/local-ai-assistant
export DEBIAN_FRONTEND=noninteractive

architecture=$(dpkg --print-architecture)
case "$${architecture}" in
  amd64) aws_cli_arch=x86_64; cw_arch=amd64 ;;
  arm64) aws_cli_arch=aarch64; cw_arch=arm64 ;;
  *) echo "Unsupported architecture: $${architecture}" >&2; exit 1 ;;
esac

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl docker.io jq nginx unzip
systemctl enable --now docker nginx

if ! command -v aws >/dev/null 2>&1; then
  aws_cli_dir=$(mktemp -d /tmp/aws-cli.XXXXXX)
  curl --fail --silent --show-error --location \
    "https://awscli.amazonaws.com/awscli-exe-linux-$${aws_cli_arch}.zip" \
    --output "$${aws_cli_dir}/awscliv2.zip"
  unzip -q "$${aws_cli_dir}/awscliv2.zip" -d "$${aws_cli_dir}"
  "$${aws_cli_dir}/aws/install"
  rm -rf -- "$${aws_cli_dir}"
fi

if ! command -v amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
  curl --fail --silent --show-error --location \
    "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/$${cw_arch}/latest/amazon-cloudwatch-agent.deb" \
    --output /tmp/amazon-cloudwatch-agent.deb
  dpkg -i /tmp/amazon-cloudwatch-agent.deb
fi

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWCONFIG'
{
  "agent": {"run_as_user": "root"},
  "metrics": {
    "namespace": "LocalAIAssistant",
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {"measurement": ["cpu_usage_idle", "cpu_usage_iowait"], "totalcpu": true},
      "disk": {"measurement": ["used_percent"], "resources": ["/"]},
      "mem": {"measurement": ["mem_used_percent"]}
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/local-ai-bootstrap.log", "log_group_name": "${bootstrap_log_group}", "log_stream_name": "{instance_id}"},
          {"file_path": "/var/log/nginx/access.log", "log_group_name": "${nginx_log_group}", "log_stream_name": "{instance_id}/access"},
          {"file_path": "/var/log/nginx/error.log", "log_group_name": "${nginx_log_group}", "log_stream_name": "{instance_id}/error"}
        ]
      }
    }
  },
  "traces": {
    "traces_collected": {
      "otlp": {"grpc_endpoint": "127.0.0.1:4317"}
    }
  }
}
CWCONFIG

cat >/etc/nginx/sites-available/local-ai-assistant <<'NGINX'
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

log_format json_combined escape=json '{'
  '"timestamp":"$time_iso8601",'
  '"remote_addr":"$remote_addr",'
  '"request_id":"$request_id",'
  '"request":"$request",'
  '"status":$status,'
  '"request_time":$request_time,'
  '"upstream_time":"$upstream_response_time",'
  '"bytes_sent":$bytes_sent'
'}';

server {
  listen 80 default_server;
  server_name _;
  access_log /var/log/nginx/access.log json_combined;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  location = /healthz {
    proxy_pass http://127.0.0.1:8501/_stcore/health;
    proxy_set_header X-Request-ID $request_id;
  }

  location / {
    proxy_pass http://127.0.0.1:8501;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }
}
NGINX

rm -f /etc/nginx/sites-enabled/default
ln -sfn /etc/nginx/sites-available/local-ai-assistant /etc/nginx/sites-enabled/local-ai-assistant
nginx -t
systemctl reload nginx

cat >/etc/local-ai-assistant/runtime.env <<'APPENV'
AWS_REGION=${aws_region}
CONFIG_PARAMETER_PATH=${parameter_prefix}
CONFIG_SECRET_ARNS=${secret_arns}
OTEL_SERVICE_NAME=local-ai-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
APPENV
chmod 0600 /etc/local-ai-assistant/runtime.env

cat >/usr/local/bin/start-local-ai-assistant <<'STARTAPP'
#!/usr/bin/env bash
set -Eeuo pipefail

image_uri='${app_image_uri}'
registry="$${image_uri%%/*}"
aws ecr get-login-password --region '${aws_region}' | docker login --username AWS --password-stdin "$${registry}"
docker pull "$${image_uri}"
docker logout "$${registry}" >/dev/null 2>&1 || true
docker rm -f local-ai-assistant >/dev/null 2>&1 || true
token=$(curl --fail --silent --show-error --request PUT \
  --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
  http://169.254.169.254/latest/api/token)
instance_id=$(curl --fail --silent --show-error \
  --header "X-aws-ec2-metadata-token: $${token}" \
  http://169.254.169.254/latest/meta-data/instance-id)
exec docker run --name local-ai-assistant --network host \
  --env-file /etc/local-ai-assistant/runtime.env \
  --log-driver awslogs \
  --log-opt awslogs-region='${aws_region}' \
  --log-opt awslogs-group='${app_log_group}' \
  --log-opt awslogs-stream="$${instance_id}" \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  --security-opt no-new-privileges --cap-drop ALL \
  "$${image_uri}"
STARTAPP
chmod 0755 /usr/local/bin/start-local-ai-assistant

cat >/etc/systemd/system/local-ai-assistant.service <<'SERVICE'
[Unit]
Description=Local AI Assistant Streamlit container
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/start-local-ai-assistant
ExecStop=/usr/bin/docker stop -t 30 local-ai-assistant
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
SERVICE

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

systemctl daemon-reload
systemctl enable --now local-ai-assistant

for _ in $(seq 1 120); do
  if curl --fail --silent http://127.0.0.1/healthz >/dev/null; then
    touch /var/lib/local-ai/bootstrap-complete
    exit 0
  fi
  sleep 5
done

echo "Streamlit did not become healthy" >&2
exit 1
