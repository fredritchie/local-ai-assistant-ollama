#!/usr/bin/env bash

set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

STATUS_DIR="/var/lib/local-ai-assistant-ollama"
COMPLETE_MARKER="$STATUS_DIR/bootstrap-complete"
FAILED_MARKER="$STATUS_DIR/bootstrap-failed"
FAILURE_LINE="unknown"
FAILURE_COMMAND="unknown"

install -d -m 0755 "$STATUS_DIR"
rm -f "$COMPLETE_MARKER" "$FAILED_MARKER"

report_exit() {
    local exit_code=$?
    [[ "$exit_code" -eq 0 ]] && return
    {
        echo "service=ollama"
        echo "status=failed"
        echo "exit_code=$exit_code"
        echo "line=$FAILURE_LINE"
        printf 'command=%q\n' "$FAILURE_COMMAND"
        echo "timestamp=$(date --iso-8601=seconds)"
    } | tee "$FAILED_MARKER" >&2
    echo "OLLAMA_BOOTSTRAP_FAILED exit_code=$exit_code" >&2
}

trap 'FAILURE_LINE=$LINENO; FAILURE_COMMAND=$BASH_COMMAND' ERR
trap report_exit EXIT

apt-get update
apt-get install -y curl ca-certificates

if ! command -v ollama >/dev/null 2>&1; then
    curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="${ollama_version}" sh
fi

install -d -m 0755 /etc/systemd/system/ollama.service.d
cat >/etc/systemd/system/ollama.service.d/network.conf <<'SERVICE'
[Service]
Environment="OLLAMA_HOST=0.0.0.0:11434"
SERVICE

systemctl daemon-reload
systemctl enable --now ollama
systemctl restart ollama

for _ in {1..60}; do
    curl --fail --silent --max-time 5 http://127.0.0.1:11434/api/tags >/dev/null && break
    sleep 2
done
curl --fail --silent --show-error --max-time 10 http://127.0.0.1:11434/api/tags >/dev/null

pull_model() {
    local model="$1"
    local required="$2"
    for attempt in 1 2 3; do
        sudo -H -u ollama ollama pull "$model" && return 0
        echo "Model pull failed for $model (attempt $attempt/3)." >&2
        sleep $((attempt * 10))
    done
    [[ "$required" == "true" ]] && return 1
    echo "Skipping optional model $model after three attempts." >&2
}

pull_model "${ollama_model}" true
for model in ${additional_ollama_models}; do
    pull_model "$model" false
done

cat >/usr/local/bin/local-ollama-health <<'HEALTH'
#!/usr/bin/env bash
set -euo pipefail
curl --fail --silent --show-error --max-time 10 http://127.0.0.1:11434/api/tags >/dev/null
echo "Ollama is healthy."
HEALTH
chmod 0755 /usr/local/bin/local-ollama-health
/usr/local/bin/local-ollama-health

{
    echo "service=ollama"
    echo "status=complete"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo "model=${ollama_model}"
} >"$COMPLETE_MARKER"
chmod 0644 "$COMPLETE_MARKER"
echo "OLLAMA_BOOTSTRAP_COMPLETE"
