#!/usr/bin/env bash

set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

BOOTSTRAP_STATUS_DIR="/var/lib/local-ai-assistant"
BOOTSTRAP_COMPLETE_MARKER="$BOOTSTRAP_STATUS_DIR/bootstrap-complete"
BOOTSTRAP_FAILED_MARKER="$BOOTSTRAP_STATUS_DIR/bootstrap-failed"
BOOTSTRAP_FAILURE_LINE="unknown"
BOOTSTRAP_FAILURE_COMMAND="unknown"

install -d -m 0755 "$BOOTSTRAP_STATUS_DIR"
rm -f "$BOOTSTRAP_COMPLETE_MARKER" "$BOOTSTRAP_FAILED_MARKER"

report_bootstrap_exit() {
    local exit_code=$?

    if [[ "$exit_code" -eq 0 ]]; then
        return
    fi

    {
        echo "status=failed"
        echo "exit_code=$exit_code"
        echo "line=$BOOTSTRAP_FAILURE_LINE"
        printf 'command=%q\n' "$BOOTSTRAP_FAILURE_COMMAND"
        echo "timestamp=$(date --iso-8601=seconds)"
        echo "Inspect /var/log/cloud-init-output.log for the complete error."
    } | tee "$BOOTSTRAP_FAILED_MARKER" >&2

    echo "LOCAL_AI_BOOTSTRAP_FAILED exit_code=$exit_code" >&2
    logger -t local-ai-assistant-bootstrap \
        "LOCAL_AI_BOOTSTRAP_FAILED exit_code=$exit_code"
}

trap 'BOOTSTRAP_FAILURE_LINE=$LINENO; BOOTSTRAP_FAILURE_COMMAND=$BASH_COMMAND' ERR
trap report_bootstrap_exit EXIT

apt-get update
apt-get install -y git curl ca-certificates python3 python3-pip python3-venv

if ! command -v ollama >/dev/null 2>&1; then
    curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="${ollama_version}" sh
fi

systemctl enable --now ollama

for _ in {1..30}; do
    if sudo -H -u ollama ollama list >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

if ! sudo -H -u ollama ollama list >/dev/null 2>&1; then
    echo "Ollama failed to start." >&2
    systemctl status ollama --no-pager >&2
    exit 1
fi

pull_model() {
    local model="$1"
    local required="$2"

    for attempt in 1 2 3; do
        if sudo -H -u ollama ollama pull "$model"; then
            return 0
        fi
        echo "Model pull failed for $model (attempt $attempt/3)." >&2
        sleep $((attempt * 10))
    done

    if [[ "$required" == "true" ]]; then
        echo "Required model $model could not be downloaded." >&2
        return 1
    fi

    echo "Skipping optional model $model after three failed attempts." >&2
}

pull_model "${ollama_model}" true
for model in ${additional_ollama_models}; do
    pull_model "$model" false
done

install -d -o ubuntu -g ubuntu /opt/local-ai-assistant-ollama

if [[ ! -d /opt/local-ai-assistant-ollama/.git ]]; then
    sudo -u ubuntu git clone \
        --branch "${repository_branch}" \
        --single-branch \
        "${repository_url}" \
        /opt/local-ai-assistant-ollama
fi

if [[ -n "${repository_commit}" ]]; then
    sudo -u ubuntu git -C /opt/local-ai-assistant-ollama fetch origin "${repository_commit}"
    sudo -u ubuntu git -C /opt/local-ai-assistant-ollama checkout --detach "${repository_commit}"
fi

sudo -u ubuntu python3 -m venv /opt/local-ai-assistant-ollama/.venv
sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install --upgrade pip
sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install \
    -r /opt/local-ai-assistant-ollama/requirements.txt

cat >/etc/systemd/system/local-ai-assistant.service <<'SERVICE'
[Unit]
Description=Local AI Assistant Streamlit application
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/local-ai-assistant-ollama
Environment=DEFAULT_MODEL=${ollama_model}
Environment=OLLAMA_BASE_URL=http://localhost:11434
ExecStart=/opt/local-ai-assistant-ollama/.venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now local-ai-assistant.service

cat >/usr/local/bin/local-ai-assistant-health <<'HEALTH'
#!/usr/bin/env bash
set -euo pipefail

curl \
    --fail \
    --silent \
    --show-error \
    --max-time 10 \
    http://127.0.0.1:8501/_stcore/health
printf '\n'
HEALTH
chmod 0755 /usr/local/bin/local-ai-assistant-health

for _ in {1..60}; do
    if /usr/local/bin/local-ai-assistant-health >/dev/null 2>&1; then
        break
    fi
    sleep 5
done

if ! /usr/local/bin/local-ai-assistant-health; then
    echo "The application failed its health check." >&2
    systemctl status local-ai-assistant --no-pager >&2 || true
    journalctl -u local-ai-assistant --no-pager -n 100 >&2 || true
    exit 1
fi

{
    echo "status=complete"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo "deployment_mode=native"
    echo "model=${ollama_model}"
} >"$BOOTSTRAP_COMPLETE_MARKER"
chmod 0644 "$BOOTSTRAP_COMPLETE_MARKER"

echo "LOCAL_AI_BOOTSTRAP_COMPLETE"
