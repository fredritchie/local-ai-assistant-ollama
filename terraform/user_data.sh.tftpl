#!/usr/bin/env bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y git curl ca-certificates python3 python3-pip python3-venv

if ! command -v ollama >/dev/null 2>&1; then
    curl -fsSL https://ollama.com/install.sh | sh
fi

systemctl enable --now ollama

for _ in {1..30}; do
    if sudo -H -u ollama ollama list >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

if ! sudo -H -u ollama ollama list >/dev/null 2>&1; then
    echo "Ollama failed to start." >&2
    systemctl status ollama --no-pager >&2
    exit 1
fi

for model in ${ollama_models}; do
    sudo -H -u ollama ollama pull "$model"
done

install -d -o ubuntu -g ubuntu /opt/local-ai-assistant-ollama

if [[ ! -d /opt/local-ai-assistant-ollama/.git ]]; then
    sudo -u ubuntu git clone \
        --branch "${repository_branch}" \
        --single-branch \
        "${repository_url}" \
        /opt/local-ai-assistant-ollama
fi

sudo -u ubuntu python3 -m venv /opt/local-ai-assistant-ollama/.venv
sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install --upgrade pip
sudo -u ubuntu /opt/local-ai-assistant-ollama/.venv/bin/python -m pip install \
    -r /opt/local-ai-assistant-ollama/requirements.txt

cat >/etc/systemd/system/local-ai-assistant.service <<'SERVICE'
[Unit]
Description=Local AI Assistant Streamlit application
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/local-ai-assistant-ollama
Environment=DEFAULT_MODEL=${ollama_model}
Environment=OLLAMA_BASE_URL=http://localhost:11434
ExecStart=/opt/local-ai-assistant-ollama/.venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now local-ai-assistant.service
